{
  "name": "@luluthehungrycat/opencode-skill-creator",
  "version": "0.1.0",
  "description": "Auto-skill creation from agent experience — turns complex workflows into reusable SKILL.md files",
  "type": "module",
  "main": "index.js",
  "opencode": {
    "type": "plugin",
    "hooks": [
      "tool.execute.after",
      "experimental.chat.system.transform",
      "config"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luluthehungrycat/phronesis.git"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.11"
  }
}
